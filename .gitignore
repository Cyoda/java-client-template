# macOS
.DS_Store

.gradle
**/build/
!src/**/build/
!buildSrc/src/**/build/

# Ignore Gradle GUI config
gradle-app.setting

# Avoid ignoring Gradle wrapper jar file (.jar files are usually ignored)
!gradle-wrapper.jar

# Avoid ignore Gradle wrappper properties
!gradle-wrapper.properties

# Cache of project
.gradletasknamecache

# Eclipse Gradle plugin generated files
# Eclipse Core
.project
# JDT-specific (Eclipse Java Development Tools)
.classpath

/.idea/**
/backup/

.playwright-mcp/
.kotlin/sessions/

.claude/worktrees
.claude/settings.local.json

# agent-safehouse local settings
.sandbox/

# Profile configs may hold credentials (e.g. config/application-cloud.yml): never commit them.
application-*.yml
application-*.yaml
# Except the template's own local-profile default, which ships as part of the repo (no credentials).
!src/main/resources/application-local.yml

# The cyoda binary scripts/install-cyoda.sh installs for the integration tests
.cyoda/

# Python version manager
.python-version
